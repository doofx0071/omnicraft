{
  "name": "create-omnicraft",
  "version": "1.0.5",
  "description": "Interactive CLI for project scaffolding across Node.js, FastAPI, and Laravel (Livewire and Inertia React), with React/Vite, Next.js, Vue, Svelte, Expo, and Tauri templates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doofx0071/omnicraft.git"
  },
  "type": "module",
  "bin": {
    "create-omnicraft": "dist/index.js",
    "omnicraft": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:integration:db": "tsx scripts/db-integration.ts",
    "test:integration:node": "tsx scripts/node-stack-integration.ts",
    "test:integration:nextjs": "tsx scripts/nextjs-runtime-integration.ts",
    "test:integration:frontend": "tsx scripts/frontend-runtime-integration.ts",
    "test:integration:docker-module": "tsx scripts/docker-module-integration.ts",
    "test:integration:modules": "tsx scripts/module-runtime-integration.ts",
    "test:integration:native": "tsx scripts/native-platform-integration.ts",
    "test:integration:python": "tsx scripts/fastapi-integration.ts",
    "test:integration:php": "tsx scripts/php-laravel-e2e.ts",
    "test:integration:php-livewire": "tsx scripts/php-livewire-auth-e2e.ts",
    "test:integration:php-inertia": "tsx scripts/php-inertia-react-auth-e2e.ts",
    "test:integration:php-sanctum-auth": "tsx scripts/php-laravel-sanctum-auth-e2e.ts",
    "test:integration:supabase-auth": "tsx scripts/supabase-auth-integration.ts",
    "check:support-matrix": "tsx scripts/check-support-evidence.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@testcontainers/mysql": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^26.6.5",
    "testcontainers": "12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
