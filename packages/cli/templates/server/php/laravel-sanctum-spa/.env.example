APP_NAME={{projectName}}
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

{{dbConfig}}

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For production subdomains, set SESSION_DOMAIN to the shared parent domain
# (for example, .example.com) and enable secure cookies over HTTPS.
# SESSION_DOMAIN=.example.com
# SESSION_SECURE_COOKIE=true
